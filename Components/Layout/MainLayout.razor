@inherits LayoutComponentBase
<MudThemeProvider @bind-IsDarkMode="@_isDark" Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <MudIconButton Icon="@(_isDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           OnClick="() => _isDark = !_isDark" />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    bool _isDark;
    MudTheme _theme = new();
}